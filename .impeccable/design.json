  "narrative": {
    "northStar": "The Company Directory",
    "overview": "The home page does two jobs for the client: say in a few lines who Crafted Comfort is, then show every company it runs. Everything else supports those two. The look is plain and confident: white ground, near-black type set large, one deep green for actions and fields, real photographs of each business.",
    "keyCharacteristics": [
      "One typeface, Archivo, in five sizes.",
      "Three colours: white ground, near-black ink, deep green.",
      "Square corners, no shadows, no gradients, no decorative motifs.",
      "Every company gets the same anatomy: photo, name, what it is, one sentence, a link."
    ],
    "rules": [
      {
        "name": "The Three Colour Rule",
        "body": "Ground, ink, green. Nothing else.",
        "section": "colors"
      },
      {
        "name": "The Two Line Rule",
        "body": "Every heading fits on two lines at every width.",
        "section": "typography"
      },
      {
        "name": "The Five Size Rule",
        "body": "No sixth size.",
        "section": "typography"
      }
    ],
    "dos": [
      "**Do** keep the home hero short and put all companies directly under it.",
      "**Do** use real photographs of each business, credited when they come from open collections.",
      "**Do** keep forms honest: they say when a request could not be sent and give the phone number."
    ],
    "donts": [
      "**Don't** add gradients, glow, glass, shadows or decorative patterns.",
      "**Don't** put a small label above a heading.",
      "**Don't** show reviews, ratings or customer numbers; none exist."
    ]
  }
